# Copy this file to .env and adjust as needed.

# When true, the app uses src/data/mockData.ts through the services layer
# instead of making real HTTP requests. Keep this "true" until the Express
# backend (built separately) is running.
VITE_USE_MOCK_DATA=true

# Base URL of the future Express REST API. Only used when
# VITE_USE_MOCK_DATA=false. Do NOT put secrets (JWT secrets, DB passwords)
# in this file — those belong on the backend only.
VITE_API_URL=http://localhost:9007/api
